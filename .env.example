EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Local Firebase emulators (firebase.json -> emulators). Start them with:
#   npx firebase emulators:start --only auth,firestore
# Set to 1 to point Auth (9099) and Firestore (8080) at the emulators instead of production.
# EXPO_PUBLIC_FIREBASE_PROJECT_ID must match the emulator project (.firebaserc default); the
# other EXPO_PUBLIC_FIREBASE_* values only need to be non-empty when using the emulator.
EXPO_PUBLIC_USE_EMULATOR=
# Emulator host as seen from the app. Default 127.0.0.1 (web, iOS simulator).
# Android emulator: 10.0.2.2. Physical device: your machine's LAN IP.
EXPO_PUBLIC_EMULATOR_HOST=
